{
  "expo": {
    "name": "RoomCheck Week 7 - Sprint 06",
    "slug": "roomcheck-week7",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "resizeMode": "contain", "backgroundColor": "#1E40AF" },
    "ios": { "supportsTablet": true, "infoPlist": { "NSMotionUsageDescription": "Digunakan untuk membaca sensor gerakan perangkat pada fitur inspeksi kamar." } },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#1E40AF" },
      "permissions": ["android.permission.BODY_SENSORS", "android.permission.HIGH_SAMPLING_RATE_SENSORS"]
    },
    "plugins": ["expo-sensors"]
  }
}
